/* Define Registered Outputs */
Q2.d = (!X & Q1 & Q0) # (!Q2 & Q1 & Q0) # (Q2 & !Q1 & !Q0) # (X & !Q2 & !Q0);
Q1.d = (!Q2 & !Q1 & Q0) # (X & !Q2 & !Q0) # (!X & Q1 & !Q0) # (X & Q2 & Q1 & Q0);
